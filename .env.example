# Copia este archivo a .env y llena los valores reales.
# Nunca subas el archivo .env real a GitHub (ya está en .gitignore).

# API key de https://serper.dev (búsqueda en Google)
SERPER_API_KEY=tu_clave_aqui

# API key de NVIDIA (LLM usado para calificación/redacción)
NVIDIA_API_KEY=tu_clave_de_nvidia_aqui
NVIDIA_MODEL=tu_modelo_de_nvidia_aqui

# Bot de Telegram usado para recordatorios
TELEGRAM_BOT_TOKEN=tu_token_de_bot_de_telegram_aqui
TELEGRAM_CHAT_ID=tu_chat_id_de_telegram_aqui
